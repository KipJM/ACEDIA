code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_disabled, unshaded;

uniform sampler2D sky_texture;
uniform float sky_strength;
uniform float prox_fade;
uniform sampler2D depth_tex_frg_6 : hint_depth_texture;
uniform float dist_fade_min;
uniform float dist_fade_max;



void fragment() {
// Input:16
	vec2 n_out16p0 = SCREEN_UV;


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(sky_texture, n_out16p0);


// FloatParameter:18
	float n_out18p0 = sky_strength;


// FloatOp:19
	float n_in19p1 = 1.00000;
	float n_out19p0 = n_out18p0 + n_in19p1;


// VectorOp:20
	vec3 n_out20p0 = vec3(n_out15p0.xyz) * vec3(n_out19p0);


// FloatParameter:9
	float n_out9p0 = prox_fade;


	float n_out6p0;
// ProximityFade:6
	{
		float __depth_tex = texture(depth_tex_frg_6, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out6p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_out9p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatParameter:10
	float n_out10p0 = dist_fade_min;


// FloatParameter:11
	float n_out11p0 = dist_fade_max;


// DistanceFade:7
	float n_out7p0 = clamp(smoothstep(n_out10p0, n_out11p0, length(VERTEX)), 0.0, 1.0);


// FloatFunc:13
	float n_out13p0 = 1.0 - n_out7p0;


// FloatOp:8
	float n_out8p0 = n_out6p0 * n_out13p0;


// VectorOp:17
	vec3 n_out17p0 = vec3(n_out15p0.xyz) * vec3(n_out18p0);


// Output:0
	ALBEDO = n_out20p0;
	ALPHA = n_out8p0;
	EMISSION = n_out17p0;


}
"
